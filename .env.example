# Proposed local URLs; this scaffold does not load these settings yet.
BACKEND_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5174
# Qdrant: export backend settings explicitly; Compose also reads root .env.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_TIMEOUT_SECONDS=3
QDRANT_IMAGE_TAG=v1.15.5
# Ollama: export explicitly; models are never pulled automatically.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
OLLAMA_GENERATION_MODEL=qwen3:4b

# SQLite file path relative to backend/; export explicitly (no implicit .env loading).
RAG_DATABASE_PATH=data/rag.sqlite3
